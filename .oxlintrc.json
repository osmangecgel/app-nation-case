{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "node"],
  "env": {
    "node": true
  },
  "ignorePatterns": ["prisma/generated/**"],
  "rules": {
    "no-console": "error",
    "no-else-return": "error",
    "complexity": ["error", 10],
    "max-depth": ["error", 3],
    "max-lines-per-function": ["error", { "max": 50, "skipBlankLines": true, "skipComments": true }],
    "typescript/no-explicit-any": "error",
    "typescript/no-restricted-types": ["error", { "types": { "unknown": "Use a concrete type (CODE-08)." } }],
    "typescript/no-non-null-assertion": "error",
    "typescript/explicit-module-boundary-types": "error",
    "typescript/no-floating-promises": "error",
    "import/no-default-export": "error",
    "node/no-process-env": "error",
    "no-restricted-imports": ["error", {
      "paths": [{ "name": "@nestjs/common", "importNames": ["forwardRef"], "message": "Use an event or a new module instead (ARCH-08)." }]
    }]
  },
  "overrides": [
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": ["error", {
          "paths": [{ "name": "@nestjs/common", "importNames": ["forwardRef"], "message": "Use an event or a new module instead (ARCH-08)." }],
          "patterns": [{ "group": ["#core/**", "#infra/**", "#modules/**", "@nestjs/**"], "message": "shared imports nothing from src and no NestJS (ARCH-02)." }]
        }]
      }
    },
    {
      "files": ["src/core/**"],
      "rules": {
        "no-restricted-imports": ["error", {
          "paths": [{ "name": "@nestjs/common", "importNames": ["forwardRef"], "message": "Use an event or a new module instead (ARCH-08)." }],
          "patterns": [{ "group": ["#infra/**", "#modules/**"], "message": "core imports only shared (ARCH-02)." }]
        }]
      }
    },
    {
      "files": ["src/infra/**"],
      "rules": {
        "no-restricted-imports": ["error", {
          "paths": [{ "name": "@nestjs/common", "importNames": ["forwardRef"], "message": "Use an event or a new module instead (ARCH-08)." }],
          "patterns": [{ "group": ["#modules/**"], "message": "infra does not import modules (ARCH-02)." }]
        }]
      }
    },
    {
      "files": ["src/modules/**"],
      "rules": {
        "no-restricted-imports": ["error", {
          "paths": [{ "name": "@nestjs/common", "importNames": ["forwardRef"], "message": "Use an event or a new module instead (ARCH-08)." }],
          "patterns": [{
            "group": ["#modules/*/**", "!#modules/*/*.module.ts", "!#modules/*/*.service.ts", "!#modules/*/*.constants.ts", "!#modules/*/dto/**", "!#modules/*/messages/**"],
            "message": "Import only another module's module, service, constants, dto/ or messages/ (ARCH-05)."
          }, {
            "group": ["#infra/queue/*/**", "#infra/ai-provider/adapters/**", "#infra/file-store/*/**"],
            "message": "Depend on the port (#infra/queue/queue.ts, #infra/ai-provider/ai-provider.ts, #infra/file-store/file-store.ts), not on an adapter (ARCH-03)."
          }]
        }]
      }
    },
    {
      "files": [
        "src/core/config/**",
        "src/core/validation/**",
        "src/core/errors/**",
        "src/core/logging/app-logger.ts",
        "src/core/logging/mask.ts",
        "src/shared/describe-error.ts",
        "src/**/*.mapper.ts",
        "src/infra/database/prisma-errors.ts"
      ],
      "rules": {
        "typescript/no-restricted-types": "off"
      }
    },
    {
      "files": ["src/core/config/**", "test/support/**"],
      "rules": {
        "node/no-process-env": "off"
      }
    },
    {
      "files": ["**/*.spec.ts", "**/*.e2e-spec.ts", "**/*.db-spec.ts"],
      "rules": {
        "max-lines-per-function": "off"
      }
    }
  ]
}
