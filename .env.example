# Copy to .env for local development: cp .env.example .env
# The app validates every variable at startup (src/core/config/env.validation.ts)
# and refuses to start with a clear message if one is missing or invalid.
# Values here are for local development only. Never put real secrets in this file (SEC-05).

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------

# development | test | production. Default: development.
# production forbids ERROR_INCLUDE_STACK=true; development enables query params in DB logs.
NODE_ENV=development

# HTTP port of the app. Also the host port published by docker-compose. Default: 13400.
PORT=13400

# ----------------------------------------------------------------------------
# PostgreSQL
# ----------------------------------------------------------------------------

# Used by docker-compose to create the database container on first start.
# Changing them later has no effect on an existing volume (docker compose down -v resets it).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_nation_case

# Host port published for PostgreSQL. Must match the port in DATABASE_URL.
POSTGRES_PORT=15432

# Connection string for the app and Prisma CLI (migrate, studio). Required.
# Must match POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB and POSTGRES_PORT above.
# Inside docker-compose the app container overrides it to reach the postgres service.
DATABASE_URL=postgresql://postgres:postgres@localhost:15432/app_nation_case?schema=public

# ----------------------------------------------------------------------------
# Redis
# ----------------------------------------------------------------------------

# Cache and rate limit counters. Evicts old keys when memory is full.
# Host port published for the cache Redis. Must match the port in CACHE_REDIS_URL.
CACHE_REDIS_PORT=16390
# Required. Inside docker-compose the app container overrides it.
CACHE_REDIS_URL=redis://localhost:16390

# ----------------------------------------------------------------------------
# Logging and errors (docs/standards/ERROR_AND_LOGGING_STANDARDS.md). All optional.
# ----------------------------------------------------------------------------

# Lowest level written: verbose | debug | log | warn | error | fatal. Default: log (LOG-05).
LOG_LEVEL=log

# pretty: coloured single lines for the terminal. json: one JSON object per line,
# for a log collector. Default: pretty in development, json elsewhere (LOG-04).
# The docker-compose app and worker use pretty.
LOG_FORMAT=pretty

# true: request and response bodies are added to the request log lines (LOG-06).
# Sensitive fields such as password and token, and a job's input and result,
# are always masked (LOG-07). Default: false.
LOG_HTTP_BODIES=false

# true: every database query is logged with its duration (LOG-08). With
# NODE_ENV=development the query parameters are logged too, and they include a
# job's input text; turn it on only to debug a query. Default: false.
LOG_DB_QUERIES=false

# true: error responses include the stack trace (ERR-08). Default: false.
# Must stay false in production; the app will not start otherwise.
ERROR_INCLUDE_STACK=true

# ----------------------------------------------------------------------------
# Rate limit (docs/standards/API_STANDARDS.md, API-09). All optional.
# ----------------------------------------------------------------------------

# Requests allowed per client IP and route within RATE_LIMIT_TTL_SECONDS.
# Over the limit the API returns 429 with Retry-After. Defaults: 60 seconds, 1000 requests.
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=1000

# Number of reverse proxies or load balancers in front of the app. Default: 0.
# 0: the X-Forwarded-For header is ignored, the socket address is the client IP.
# Production behind a load balancer: set it (usually 1), otherwise every user
# shares the proxy's IP and one rate limit counter.
# Do not set it without a proxy: clients could spoof the header to dodge the limit.
TRUST_PROXY_HOPS=0
# ----------------------------------------------------------------------------
# Jobs. All optional.
# ----------------------------------------------------------------------------

# Unfinished jobs one user may have at once. Over it POST /v1/jobs returns 429
# too_many_active_jobs. Default: 50.
MAX_ACTIVE_JOBS_PER_USER=50

# How often job types, prices, providers and routes are reloaded from the
# database, in milliseconds. Default: 30000.
JOB_CONFIG_REFRESH_MS=30000

# ----------------------------------------------------------------------------
# Kafka and the worker. All optional.
# ----------------------------------------------------------------------------

# Which broker carries job messages: an adapter folder under src/infra/queue/.
# Only kafka exists today; see docs/design.md, "Adding a broker or a provider".
QUEUE_DRIVER=kafka

# AI provider adapters to load, comma-separated (src/infra/ai-provider/adapters/).
# job_providers.adapter picks among them per job. Default: fake.
AI_PROVIDER_ADAPTERS=fake

# CSV export. stream (default, the case's behaviour): GET /v1/jobs/export.csv
# streams the file. async: it answers 202 with an export prepared in the
# background (/v1/exports). auto: streams up to EXPORT_STREAM_MAX_ROWS jobs, else async.
EXPORT_MODE=stream
EXPORT_STREAM_MAX_ROWS=10000
# Streamed exports at once across every API instance (a lease in Redis); per
# instance while Redis is down. A request waits this long for a slot, then 429.
EXPORT_MAX_CONCURRENT=200
EXPORT_FALLBACK_MAX_CONCURRENT=20
EXPORT_ADMISSION_WAIT_MS=10000
# Background exports one worker prepares at once, and how long a file is kept.
EXPORT_WORKER_CONCURRENCY=2
EXPORT_FILE_TTL_MS=86400000
# Where prepared files are kept (docker-compose uses a shared volume at /data/exports).
EXPORT_FILES_DIR=./data/exports

# Host port of Kafka, and the address the worker uses outside Docker.
KAFKA_PORT=19092
KAFKA_BROKERS=localhost:${KAFKA_PORT}

# Provider calls one worker makes at once. Default: 4.
WORKER_PROVIDER_CONCURRENCY=4
# Jobs one worker holds at once, from all its Kafka partitions together. A job
# waiting for a provider permit costs no database work, so this only bounds
# memory. Default: 500.
WORKER_JOB_CONCURRENCY=500
# A claimed job stays with its worker for WORKER_LEASE_MS; the worker extends it
# every WORKER_HEARTBEAT_MS. A dead worker's job is taken over when it expires.
WORKER_LEASE_MS=15000
WORKER_HEARTBEAT_MS=5000
# On SIGTERM, jobs in flight may finish within this time, then go back to the queue.
WORKER_SHUTDOWN_GRACE_MS=25000
# How often the outbox relay publishes to Kafka, and the reconciler looks for stuck jobs.
OUTBOX_RELAY_INTERVAL_MS=200
RECONCILER_INTERVAL_MS=5000
# A queued job nobody picked up for this long is dispatched again.
RECONCILER_STALE_QUEUED_MS=120000
