  "info": {
    "title": "app-nation-case API",
    "description": "Error responses follow RFC 9457 (application/problem+json).",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded",
              "error"
            ],
            "description": "ok when every component is up; degraded when only the cache is down (requests still succeed); error when the database is down.",
            "example": "ok"
          },
          "database": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ],
            "description": "PostgreSQL.",
            "example": "up"
          },
          "cache": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ],
            "description": "Cache Redis. Optional.",
            "example": "up"
          }
        },
        "required": [
          "status",
          "database",
          "cache"
        ],
        "additionalProperties": false,
        "description": "Reachability of the API and its dependencies."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "HTTP status text.",
            "example": "Payment Required"
          },
          "status": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "HTTP status code.",
            "example": 402
          },
          "detail": {
            "type": "string",
            "description": "Developer-facing explanation in English.",
            "example": "Not enough credits for this job."
          },
          "instance": {
            "type": "string",
            "description": "Request path.",
            "example": "/v1/jobs"
          },
          "code": {
            "type": "string",
            "description": "Stable error code; clients choose their message by it.",
            "example": "INSUFFICIENT_CREDITS"
          },
          "error": {
            "type": "string",
            "description": "The code in lowercase, for clients that read error.",
            "example": "insufficient_credits"
          },
          "requestId": {
            "type": "string",
            "description": "Id of the request, for support. Same as the x-request-id header and the requestId in our logs.",
            "example": "4bf92f3577b34da6a3ce929d0e0e4736"
          },
          "errors": {
            "description": "Field-level errors, only for validation failures.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "description": "Path of the invalid field.",
                  "example": "input"
                },
                "code": {
                  "type": "string",
                  "enum": [
                    "REQUIRED",
                    "INVALID_TYPE",
                    "INVALID_FORMAT",
                    "INVALID_VALUE",
                    "TOO_SMALL",
                    "TOO_BIG",
                    "UNKNOWN_FIELD",
                    "ALREADY_EXISTS"
                  ],
                  "description": "Stable field error code.",
                  "example": "REQUIRED"
                },
                "message": {
                  "type": "string",
                  "description": "Developer-facing explanation in English.",
                  "example": "Field is required."
                }
              },
              "required": [
                "field",
                "code",
                "message"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "error",
          "requestId"
        ],
        "additionalProperties": false,
        "description": "RFC 9457 problem details."
      },
      "JobExport": {
        "type": "object",
        "properties": {
          "exportId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "Id to poll the export with."
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "processing",
              "ready",
              "failed",
              "canceled",
              "expired"
            ],
            "description": "queued and processing: being prepared. ready: the file can be downloaded until expiresAt.",
            "example": "processing"
          },
          "rowCount": {
            "nullable": true,
            "description": "Jobs in the file, once ready.",
            "example": null,
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "errorCode": {
            "nullable": true,
            "description": "Set when the export failed.",
            "example": null,
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "finishedAt": {
            "nullable": true,
            "description": "Null while queued or processing.",
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "expiresAt": {
            "nullable": true,
            "description": "When the file is deleted; set once ready.",
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "exportId",
          "status",
          "rowCount",
          "errorCode",
          "createdAt",
          "finishedAt",
          "expiresAt"
        ],
        "additionalProperties": false
      },
      "GrantCredits": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000,
            "description": "Credits to add to the balance.",
            "example": 10
          }
        },
        "required": [
          "amount"
        ],
        "additionalProperties": false
      },
      "UserCredits": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[\\x21-\\x7e]+$",
            "description": "Caller id. Authentication is out of scope.",
            "example": "user-1"
          },
          "balance": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Credits that can be spent now.",
            "example": 7
          },
          "reserved": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Credits held by unfinished jobs; captured or released when they finish.",
            "example": 3
          }
        },
        "required": [
          "userId",
          "balance",
          "reserved"
        ],
        "additionalProperties": false
      },
      "CreateJob": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "description": "Job type.",
            "example": "summary"
          },
          "input": {
            "type": "string",
            "description": "Text to process. Must not be blank; the maximum length depends on the job type (20000 characters).",
