              "queued",
              "processing",
              "completed",
              "failed"
            ],
            "example": "completed"
          },
          "errorCode": {
            "nullable": true,
            "description": "Set when the job failed.",
            "example": null,
            "type": "string"
          },
          "cost": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Credits reserved for the job.",
            "example": 3
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "finishedAt": {
            "nullable": true,
            "description": "Null while the job is queued or processing.",
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "result": {
            "nullable": true,
            "description": "Set when the job completed.",
            "example": "Özet: merhaba dünya",
            "type": "string"
          }
        },
        "required": [
          "jobId",
          "type",
          "status",
          "errorCode",
          "cost",
          "createdAt",
          "finishedAt",
          "result"
        ],
        "additionalProperties": false
      },
