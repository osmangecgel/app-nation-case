{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Used by load balancers and orchestrators. Returns 503 only when the database is unreachable: without the cache the API keeps serving requests, so it reports degraded with 200.",
        "operationId": "health.check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The API can serve requests (ok or degraded).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "500": {
            "description": "Error codes: INTERNAL_ERROR.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503": {
            "description": "The database is down.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        },
        "summary": "Check the API and its dependencies",
        "tags": [
          "health"
        ]
      }
    },
    "/internal/users/{id}/credits": {
      "post": {
        "description": "Creates the user on the first grant. Writes a grant entry to the credit ledger.",
        "operationId": "users.grant",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[\\x21-\\x7e]+$",
              "description": "Caller id. Authentication is out of scope.",
              "example": "user-1"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GrantCredits"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserCredits"
                }
              }
            }
          },
          "400": {
            "description": "Error codes: VALIDATION_FAILED, INVALID_JSON.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "413": {
            "description": "Error codes: PAYLOAD_TOO_LARGE.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Error codes: BALANCE_LIMIT_EXCEEDED.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Error codes: TOO_MANY_REQUESTS.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Error codes: INTERNAL_ERROR.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "summary": "Add credits to a user",
        "tags": [
          "internal"
        ]
      },
      "get": {
        "description": "A user who never received credits has zero balance.",
        "operationId": "users.get",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[\\x21-\\x7e]+$",
              "description": "Caller id. Authentication is out of scope.",
              "example": "user-1"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserCredits"
                }
              }
            }
          },
          "400": {
            "description": "Error codes: VALIDATION_FAILED.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Error codes: TOO_MANY_REQUESTS.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Error codes: INTERNAL_ERROR.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "summary": "Get a user's credits",
        "tags": [
          "internal"
        ]
      }
    },
    "/v1/jobs": {
      "post": {
        "description": "Reserves the job cost from the balance and queues the job. The result is fetched later by job id.",
        "operationId": "jobs.create",
        "parameters": [
          {
            "name": "X-User-Id",
            "in": "header",
            "description": "Caller id: 1 to 64 printable ASCII characters. Authentication is out of scope.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "Unique per request, at most 255 characters. A retry with the same key and body returns the first response for 24 hours.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateJob"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobCreated"
                }
              }
            }
          },
          "400": {
            "description": "Error codes: VALIDATION_FAILED, INVALID_JSON.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Error codes: USER_ID_REQUIRED.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "402": {
            "description": "Error codes: INSUFFICIENT_CREDITS.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Error codes: CONFLICT.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "413": {
            "description": "Error codes: PAYLOAD_TOO_LARGE.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Error codes: IDEMPOTENCY_KEY_REUSED.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Error codes: TOO_MANY_ACTIVE_JOBS, TOO_MANY_REQUESTS.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Error codes: INTERNAL_ERROR.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "summary": "Start a job",
        "tags": [
          "jobs"
        ]
      },
      "get": {
        "description": "Newest first, with cursor pagination.",
        "operationId": "jobs.list",
        "parameters": [
          {
            "name": "X-User-Id",
            "in": "header",
            "description": "Caller id: 1 to 64 printable ASCII characters. Authentication is out of scope.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "default": 20,
              "description": "Rows per page, from 1 to 100.",
              "example": 20,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "schema": {
              "description": "nextCursor from the previous page. Leave empty for the first page.",
              "type": "string"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "description": "Only jobs in this status.",
              "type": "string",
              "enum": [
                "queued",
                "processing",
                "completed",
                "failed"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobPage"
                }
              }
            }
          },
          "400": {
            "description": "Error codes: VALIDATION_FAILED.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Error codes: USER_ID_REQUIRED.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Error codes: TOO_MANY_REQUESTS.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Error codes: INTERNAL_ERROR.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "summary": "List jobs",
        "tags": [
          "jobs"
        ]
      }
    },
    "/v1/jobs/export.csv": {
      "get": {
        "description": "Every job of the caller, newest first. Columns: job_id, type, status, cost, error_code, created_at, finished_at. EXPORT_MODE stream (default) streams the file; async answers 202 with an export to poll (see /v1/exports); auto streams up to EXPORT_STREAM_MAX_ROWS jobs and answers 202 above. At most one streamed export per user and a bounded number in total: a request waits up to EXPORT_ADMISSION_WAIT_MS for a slot, then gets 429 with Retry-After.",
        "operationId": "jobs.export",
        "parameters": [
          {
            "name": "X-User-Id",
            "in": "header",
            "description": "Caller id: 1 to 64 printable ASCII characters. Authentication is out of scope.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "CSV file."
          },
          "202": {
            "description": "Prepared in the background; poll Location.",
            "content": {
              "text/csv": {
                "schema": {
                  "$ref": "#/components/schemas/JobExport"
                }
              }
            }
          },
          "401": {
            "description": "Error codes: USER_ID_REQUIRED.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Error codes: EXPORT_IN_PROGRESS, EXPORT_SLOTS_BUSY, TOO_MANY_REQUESTS.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Error codes: INTERNAL_ERROR.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "summary": "Download all jobs as CSV",
        "tags": [
          "jobs"
        ]
      }
    },
